\AtEveryBibitem{%
    \clearfield{note}%
    \clearfield{language}%
      \ifentrytype{article}{%
            \clearfield{pages}%
            \clearfield{eid}%
      }{}%
}

\newbibmacro*{linkedtitle}[1]{%
      \iffieldundef{doi}{%
            \iffieldundef{url}{%
                  #1%
            }{%
                  \href{\thefield{url}}{#1}%
            }%
      }{%
            \href{https://doi.org/\thefield{doi}}{#1}%
      }%
}

\renewbibmacro*{title}{%
  \ifboolexpr{%
    test {\iffieldundef{title}}
    and
    test {\iffieldundef{subtitle}}
  }
    {}
    {\usebibmacro{linkedtitle}{%
       \printtext[title]{%
         \printfield[titlecase]{title}%
         \setunit{\subtitlepunct}%
         \printfield[titlecase]{subtitle}}}%
     \newunit}%
  \printfield{titleaddon}}

\renewbibmacro*{journal}{%
      \ifboolexpr{%
            test {\iffieldundef{journaltitle}}
            and
            test {\iffieldundef{journalsubtitle}}
            and
            test {\iffieldundef{shortjournal}}
      }
            {}
            {\printtext[journaltitle]{%
                   \iffieldundef{shortjournal}
                          {\printfield[noformat]{journaltitle}%
                              \setunit{\subtitlepunct}%
                                \printfield[noformat]{journalsubtitle}}
                          {\printfield[noformat]{shortjournal}}}%
             \newunit}%
      \iffieldundef{journaltitleaddon}
            {}
            {\printfield{journaltitleaddon}}}

\renewbibmacro*{note+pages}{%
      \printfield{note}%
      \setunit{\bibpagespunct}%
      \printfield{pages}%
}

