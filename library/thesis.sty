% dont work break in titles
\usepackage[raggedright]{titlesec}
\newcommand{\chapteroverlaynumber}{%
      \makebox[0pt][l]{%
            \smash{%
                  \raisebox{-1.42\baselineskip}[0pt][0pt]{%
                        \hspace*{-0.28em}%
                        \textcolor{black!11}{%
                              \scalebox{4.7}[4.7]{\normalfont\bfseries\thechapter}%
                        }%
                  }%
            }%
      }%
}
\newcommand{\currentchapternumber}{}
\newcommand{\currentchaptertitle}{}
\newcommand{\currentchapterheader}{%
      \ifx\currentchapternumber\empty
            \currentchaptertitle
      \else
            \currentchapternumber\space-\space\currentchaptertitle
      \fi
}
\titleformat{\chapter}[display]
      {\normalfont\Huge\bfseries}
      {\chapteroverlaynumber}
      {0pt}
      {\raggedright\leftskip=1.15em\relax}
\titleformat{name=\chapter,numberless}[display]
      {\normalfont\Huge\bfseries}
      {}
      {0pt}
      {}
\titleformat*{\section}{\normalfont\Large\bfseries\boldmath}
\titlespacing*{\chapter}{0pt}{18pt}{34pt}
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{18pt}
\titlespacing*{\section}{0pt}{18pt}{8pt}
\titlespacing*{\subsection}{0pt}{14pt}{6pt}
\let\originalchapter\chapter
\RenewDocumentCommand{\chapter}{s o m}{%
      \IfBooleanTF{#1}{%
            \gdef\currentchapternumber{}%
            \gdef\currentchaptertitle{}%
            \originalchapter*{#3}%
      }{%
            \IfNoValueTF{#2}{%
                  \originalchapter{#3}%
                  \xdef\currentchapternumber{\thechapter}%
                  \gdef\currentchaptertitle{#3}%
                  \markboth{#3}{}%
            }{%
                  \originalchapter[#2]{#3}%
                  \xdef\currentchapternumber{\thechapter}%
                  \gdef\currentchaptertitle{#2}%
                  \markboth{#2}{}%
            }%
            \thispagestyle{chapteropening}%
            \pagestyle{fancy}%
            \afterpage{\pagestyle{fancy}}%
      }%
}

