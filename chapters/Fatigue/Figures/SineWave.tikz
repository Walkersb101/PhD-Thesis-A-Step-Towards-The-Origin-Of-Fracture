\begin{tikzpicture}[xscale=10, yscale=2]
        % Shading from 0 to 0.25 (pi/2)
    \fill[gray] (0, -1.2) rectangle (0.25, 1.2);
    
    % Shading from 0.5 to 0.75 (pi to 3pi/2)
    \fill[gray] (0.5, -1.2) rectangle (0.75, 1.2);

    % Draw the axes
    \draw[->] (-0.1, 0) -- (1.2, 0) node[right] {$c$};
    \draw[->] (0, -1.2) -- (0, 1.2) node[above] {$\gamma$};

    % 2. Region Labels (1-4)
    % Placed at the top (y=1.3) in the center of each quadrant
    \node[font=\bfseries] at (0.125, 1.3) {1};
    \node[font=\bfseries] at (0.375, 1.3) {2};
    \node[font=\bfseries] at (0.625, 1.3) {3};
    \node[font=\bfseries] at (0.875, 1.3) {4};

    % Plot the sine wave: sin(2*pi*x)
    % This places the nodes exactly at 0.5 and 1.0
    \draw[thick, blue, smooth] plot[domain=0:1, samples=100] (\x, {sin(2*pi*\x r)});

    % Labels only at the two specific nodes on the x-axis
    % Node at 1/2
    \draw (0.0, 0.05) -- (0.0, -0.05) node[below right] {$0$};

    % Labels only at the two specific nodes on the x-axis
    % Node at 1/2
    \draw (0.5, 0.05) -- (0.5, -0.05) node[below] {$1/2$};
    
    % Node at 1
    \draw (1, 0.05) -- (1, -0.05) node[below] {$1$};

    % Optional: markers for amplitude if you still want them
    \draw (0.02, 1) -- (-0.02, 1) node[left] {$\gamma_0$};
    \draw (0.02, -1) -- (-0.02, -1) node[left] {$-\gamma_0$};

\end{tikzpicture}