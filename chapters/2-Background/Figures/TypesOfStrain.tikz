\begin{tikzpicture}
    % Extensional Strain
    \begin{scope}
        % Natural state - Unit Square
        \draw[dashed, line width=1pt] (0,0) rectangle (1,1);

        % Deformed state - Extended y-direction
        \draw[line width=2pt, fill=gray!30, fill opacity=0.7] (0,0) rectangle (1, 1.5);
        
        % Label Epsilon - measuring the extension part
        \draw[densely dotted, thick] (1, 1) -- (1.4, 1);
        \draw[densely dotted, thick] (1, 1.5) -- (1.4, 1.5);
        \draw[<->, >=stealth, line width=1pt] (1.3, 1) -- (1.3, 1.5) node[midway, right] {\Large $\epsilon$};

        \node[anchor=north] at (0.5, -0.2) {\Large Extensional};
    \end{scope}

    % Simple Shear Strain
    \begin{scope}[xshift=3.5cm]
        % Natural state - Unit Square
        \draw[dashed, line width=1pt] (0,0) rectangle (1,1);

        % Deformed state - Sheared
        % (x,y) -> (x + gamma*y, y) with gamma = 0.5
        \draw[line width=2pt, fill=gray!30, fill opacity=0.7] (0,0) -- (1,0) -- (1.5,1) -- (0.5,1) -- cycle;
        
        % Label Gamma
        \draw[densely dotted, thick] (0, 1) -- (0, 1.4);
        \draw[densely dotted, thick] (0.5, 1) -- (0.5, 1.4);
        \draw[<->, >=stealth, line width=1pt] (0, 1.3) -- (0.5, 1.3) node[midway, above] {\Large $\gamma$};

        \node[anchor=north] at (1.0, -0.2) {\Large Shear};
    \end{scope}
\end{tikzpicture}
