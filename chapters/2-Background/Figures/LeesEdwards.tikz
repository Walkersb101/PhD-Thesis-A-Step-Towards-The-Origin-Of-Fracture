\begin{tikzpicture}
    % Unit Cell
    \draw[line width=4pt, fill=gray!30] (0,0) rectangle (1,1);

    % X periodic
    \draw[] (-1, 0) rectangle (0, 1);
    \draw[] (+1, 0) rectangle (2, 1);

    % top row 
    \draw[] (-0.5, 1) rectangle (0.5, 2);
    \draw[] (+0.5, 1) rectangle (1.5, 2);
    \draw[] (+1.5, 1) rectangle (2.5, 2);

    % bottom row 
    \draw[] (-1.5, -1) rectangle (-0.5, 0);
    \draw[] (-0.5, -1) rectangle (+0.5, 0);
    \draw[] (+0.5, -1) rectangle (+1.5, 0);

    % Lattice vectors
    \draw[->] (0.5,0.5) -- (1.0,1.5) node[anchor=south west] {\Large $\bm{a}$};
    \draw[->] (0.5,0.5) -- (1.5,0.5) node[anchor=west] {\Large $\bm{b}$} ;

    % Strain vectors
    \draw[dashed] (-1.5,-1) -- (0,2);
    \draw[dashed] (-0.5,-1) -- (1.0,2);
    \draw[dashed] (0.5,-1) -- (2.0,2);

  \end{tikzpicture}