\begin{tikzpicture}
\begin{axis}[
    width=8cm,
    height=4cm,
    xlabel={$t$},
    ylabel={$\dfrac{\sigma}{\sigma_0}$},
    ylabel style={rotate=-90, font=\Large, yshift=10pt},
    xlabel style={font=\Large},
    xmin=0, xmax=10,
    ymin=0.75, ymax=1.02,
    samples=400,
    thick,
    axis lines=left,
    xtick=\empty,
    ytick=\empty,
]
    % Flat → slow decay → flat plateau
    \addplot[color=blue, domain=0:10]
        {0.9 + 0.1*tanh(0.8*(3.5 - x))};

    \addplot[color=red, domain=0:10]
        {0.5*(1 - tanh(0.8*(x - 4.5)))};
\end{axis}
\end{tikzpicture}
