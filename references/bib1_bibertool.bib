  NUMBER = {11},
  PAGES = {4423--4435},
  SHORTJOURNAL = {J. Chem. Phys.},
  SHORTTITLE = {Dissipative particle dynamics},
  TITLE = {Dissipative particle dynamics: Bridging the gap between atomistic and mesoscopic simulation},
  URLDATE = {2023-05-02},
  VOLUME = {107},
}

