  NOTE = {Publisher: IOP Publishing},
  NUMBER = {10},
  PAGES = {102601},
  SHORTJOURNAL = {Rep. Prog. Phys.},
  TITLE = {Shear banding in soft glassy materials},
  URLDATE = {2025-09-04},
  VOLUME = {77},
}

