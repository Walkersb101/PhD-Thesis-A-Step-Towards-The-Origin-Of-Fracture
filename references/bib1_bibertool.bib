  LANGID = {english},
  NUMBER = {4},
  PAGES = {607--614},
  SHORTJOURNAL = {Nat. Mater.},
  TITLE = {Rapid Self-Strengthening in Double-Network Hydrogels Triggered by Bond Scission},
