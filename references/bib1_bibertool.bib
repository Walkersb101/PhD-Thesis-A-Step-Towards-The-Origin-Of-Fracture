  EPRINT = {https://agupubs.onlinelibrary.wiley.com/doi/pdf/10.1029/2021RG000743},
  JOURNALTITLE = {Reviews of Geophysics},
  KEYWORDS = {structural glaciology,ice deformation,ice structures,Foliation,Crevasses,structurally controlled landforms},
  NOTE = {e2021RG000743 2021RG000743},
