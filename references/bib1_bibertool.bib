  SHORTJOURNAL = {J. Chem. Phys.},
  SHORTTITLE = {Stretchy and disordered},
  TITLE = {Stretchy and disordered: {Toward} understanding fracture in soft network materials via mesoscopic computer simulations},
  URLDATE = {2023-04-04},
  VOLUME = {156},
}

