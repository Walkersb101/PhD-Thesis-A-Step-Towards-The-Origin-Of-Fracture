  SHORTJOURNAL = {Phys. Rev. Lett.},
  TITLE = {Metastability as a {Mechanism} for {Yielding} in {Amorphous} {Solids} under {Cyclic} {Shear}},
  URLDATE = {2025-05-19},
  VOLUME = {127},
