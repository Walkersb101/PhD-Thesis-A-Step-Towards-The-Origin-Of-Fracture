  SHORTJOURNAL = {Phys. Rev. E},
  TITLE = {Experimental signatures of a nonequilibrium phase transition governing the yielding of a soft glass},
  URLDATE = {2025-05-19},
  VOLUME = {89},
}

@ARTICLE{nessAbsorbingStateTransitionsGranular2020,
  ABSTRACT = {We consider a model for driven particulate matter in which absorbing states can be reached both by particle isolation and by particle caging. The model predicts a nonequilibrium phase diagram in which analogs of hydrodynamic and elastic reversibility emerge at low and high volume fractions respectively, partially separated by a diffusive, nonabsorbing region. We thus find a single phase boundary that spans the onset of chaos in sheared suspensions to the onset of yielding in jammed packings. This boundary has the properties of a nonequilibrium second order phase transition, leading us to write a Manna-like mean field description that captures the model predictions. Dependent on contact details, jamming marks either a direct transition between the two absorbing states, or occurs within the diffusive region.},
  AUTHOR = {Ness, Christopher and Cates, Michael E.},
  URL = {https://link.aps.org/doi/10.1103/PhysRevLett.124.088004},
