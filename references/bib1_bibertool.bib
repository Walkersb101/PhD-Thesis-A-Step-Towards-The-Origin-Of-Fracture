  KEYWORDS = {Flowing Matter: Liquids and Complex Fluids},
  NUMBER = {7},
  PAGES = {71},
  SHORTJOURNAL = {Eur. Phys. J. E},
  TITLE = {On the relevance of disorder in athermal amorphous materials under shear},
  URLDATE = {2026-02-09},
  VOLUME = {38},
}

