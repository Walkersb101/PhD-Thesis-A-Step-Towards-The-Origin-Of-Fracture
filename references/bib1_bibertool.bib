  PAGES = {523--549},
  SHORTJOURNAL = {J. Mech. Phys. Solids},
  TITLE = {A continuum model for progressive damage in tough multinetwork elastomers},
  URLDATE = {2025-12-22},
  VOLUME = {125},
}

