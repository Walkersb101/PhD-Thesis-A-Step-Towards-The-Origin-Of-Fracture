  date = {2011-08-01},
  journaltitle = {Microelectronic Engineering},
  shortjournal = {Microelectronic Engineering},
  series = {Proceedings of the 36th {{International Conference}} on {{Micro-}} and {{Nano-Engineering}} ({{MNE}})},
  volume = {88},
