  shorttitle = {Mechanical {{Yield}} in {{Amorphous Solids}}},
  author = {Jaiswal, Prabhat K. and Procaccia, Itamar and Rainone, Corrado and Singh, Murari},
  date = {2016-02-23},
  journaltitle = {Physical Review Letters},
  shortjournal = {Phys. Rev. Lett.},
  volume = {116},
