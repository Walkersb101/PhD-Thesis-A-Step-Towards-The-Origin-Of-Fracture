@article{li_finite_2016,
	series = {International {Conference} on {Computational} {Science} 2016, {ICCS} 2016, 6-8 {June} 2016, {San} {Diego}, {California}, {USA}},
	title = {Finite {Element} {Model} for {Brittle} {Fracture} and {Fragmentation}},
