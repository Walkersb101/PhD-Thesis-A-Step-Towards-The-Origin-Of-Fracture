	urldate = {2023-08-16},
	journal = {Physical Review E},
	author = {Lengliné, Olivier and Toussaint, Renaud and Schmittbuhl, Jean and Elkhoury, Jean E. and Ampuero, J. P. and Tallakstad, Ken Tore and Santucci, Stéphane and Måløy, Knut Jørgen},
