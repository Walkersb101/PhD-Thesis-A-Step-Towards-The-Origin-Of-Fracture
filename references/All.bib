@article{picard_elastic_2004,
	title = {Elastic consequences of a single plastic event: {A} step towards the microscopic modeling of the flow of yield stress fluids},
	volume = {15},
	issn = {1292-8941, 1292-895X},
	shorttitle = {Elastic consequences of a single plastic event},
	url = {http://link.springer.com/10.1140/epje/i2004-10054-8},
